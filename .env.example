# Copy to /home/mjnetwork/lamp/beest-license/.env — NEVER commit real values.
BEEST_ADMIN_USER=owner
BEEST_ADMIN_PW_HASH=
BEEST_ADMIN_TOTP_SEED=
# ^ leave empty = MFA disabled (password only). Set a base32 seed to require TOTP.
BEEST_SESSION_SECRET=generate-32plus-random-chars-here
BEEST_KEY_ID=k1
BEEST_LICENSE_ISSUER=beest.cikgututor.com
BEEST_PUBLIC_URL=https://beest.cikgututor.com
BEEST_DATA_DIR=/data
# Optional: "203.0.113.10" if your IP is stable
BEEST_ADMIN_IP_ALLOWLIST=
